{
  "name": "appstore/screenshots",
  "version": "1.0.3",
  "description": "Capture a sequence of on-screen screenshots from the App Store product media carousel (best-effort).",
  "capability": {
    "family": "extract",
    "intent": "screenshots",
    "surface": "native_app",
    "mutating": false
  },
  "inputs": {
    "query": { "type": "string", "required": true },
    "result_index": { "type": "integer", "default": 0, "min": 0, "max": 50 },
    "submit_mode": { "type": "string", "default": "keyboard" },
    "country": { "type": "string" },
    "locale": { "type": "string" }
  },
  "notes": [
    "Captures full-screen screenshots after swiping the product media carousel.",
    "Result contains up to 5 screen captures (not cropped to the media frame).",
    "result_index is 0-based (0 = first search result)."
  ],
  "steps": [
    { "tool": "ios.appium.ensure", "arguments": {} },
    {
      "tool": "ios.session.create",
      "arguments": {
        "udid": "{{udid}}",
        "kind": "native_app",
        "bundleId": "com.apple.AppStore",
        "replaceExisting": true,
        "noReset": true,
        "showXcodeLog": "{{showXcodeLog}}",
        "allowProvisioningUpdates": "{{allowProvisioningUpdates}}",
        "allowProvisioningDeviceRegistration": "{{allowProvisioningDeviceRegistration}}",
        "sessionCreateTimeoutMs": "{{sessionCreateTimeoutMs}}",
        "wdaLaunchTimeoutMs": "{{wdaLaunchTimeoutMs}}",
        "wdaConnectionTimeoutMs": "{{wdaConnectionTimeoutMs}}",
        "signing": {
          "xcodeOrgId": "{{xcodeOrgId}}",
          "xcodeSigningId": "{{xcodeSigningId}}",
          "updatedWDABundleId": "{{updatedWDABundleId}}"
        }
      }
    },
    {
      "tool": "ios.app.activate",
      "arguments": {
        "bundleId": "com.apple.AppStore",
        "terminateFirst": true
      }
    },
    { "tool": "util.sleep", "arguments": { "minMs": 1500, "maxMs": 1500 } },
    {
      "tool": "ios.action.wait",
      "arguments": {
        "target": { "using": "accessibility id", "value": "AppStore.tabBar.search" },
        "timeoutMs": 30000
      },
      "retries": 1
    },
    {
      "tool": "ios.action.tap",
      "arguments": {
        "target": { "using": "accessibility id", "value": "AppStore.tabBar.search" }
      }
    },
    {
      "tool": "ios.action.tap",
      "arguments": {
        "target": { "using": "accessibility id", "value": "AppStore.searchField" }
      }
    },
    {
      "tool": "ios.action.type",
      "when": { "var": "submit_mode", "equals": "suggestion" },
      "arguments": {
        "target": { "using": "accessibility id", "value": "AppStore.searchField" },
        "text": "{{query}}",
        "clearFirst": true
      }
    },
    {
      "tool": "ios.action.type",
      "when": { "var": "submit_mode", "equals": "keyboard" },
      "arguments": {
        "target": { "using": "accessibility id", "value": "AppStore.searchField" },
        "text": "{{query}}",
        "clearFirst": true,
        "pressEnter": true
      }
    },
    {
      "tool": "ios.ui.extract_text",
      "when": { "var": "submit_mode", "equals": "keyboard" },
      "saveAs": "keyboardHints",
      "arguments": {
        "query": { "type": "XCUIElementTypeCell", "ancestorName": "AppStore.searchHints", "max": 2 },
        "limit": 2,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "util.list.first",
      "when": { "var": "submit_mode", "equals": "keyboard" },
      "saveAs": "keyboardHintFirst",
      "arguments": { "list": "{{steps.keyboardHints.texts}}" }
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "steps.keyboardHintFirst.found", "truthy": true },
      "arguments": { "target": { "using": "xpath", "value": "//XCUIElementTypeCollectionView[@name='AppStore.searchHints']//XCUIElementTypeCell[1]" } }
    },
    {
      "tool": "ios.action.wait",
      "when": { "var": "submit_mode", "equals": "suggestion" },
      "arguments": {
        "target": { "using": "xpath", "value": "//XCUIElementTypeCollectionView[@name='AppStore.searchHints']//XCUIElementTypeCell[1]" },
        "timeoutMs": 10000
      },
      "retries": 1
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "submit_mode", "equals": "suggestion" },
      "arguments": { "target": { "using": "xpath", "value": "//XCUIElementTypeCollectionView[@name='AppStore.searchHints']//XCUIElementTypeCell[1]" } }
    },
    {
      "tool": "ios.action.wait",
      "arguments": {
        "target": { "using": "xpath", "value": "//XCUIElementTypeCell[starts-with(@name, 'AppStore.shelfItem.searchResult')]" },
        "timeoutMs": 30000
      },
      "retries": 1
    },
    {
      "tool": "ios.ui.extract_rows",
      "saveAs": "searchResults",
      "arguments": {
        "row": {
          "type": "XCUIElementTypeCell",
          "namePrefix": "AppStore.shelfItem.searchResult"
        },
        "primary": {
          "type": "XCUIElementTypeButton",
          "attr": "label",
          "pick": "longest"
        },
        "split": {
          "delimiter": ",",
          "fields": ["name", "subtitle", "developer"],
          "skipMetricLike": true
        },
        "limit": 12
      }
    },
    {
      "tool": "util.rank_by_name",
      "saveAs": "targetResultRank",
      "arguments": {
        "items": "{{steps.searchResults.rows}}",
        "field": "name",
        "target": "{{query}}"
      }
    },
    {
      "tool": "util.list.nth",
      "when": { "var": "steps.targetResultRank.rank", "exists": true },
      "saveAs": "selectedTargetResult",
      "arguments": {
        "list": "{{steps.searchResults.rows}}",
        "index": "{{steps.targetResultRank.rank}}"
      }
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "steps.selectedTargetResult.found", "truthy": true },
      "arguments": {
        "point": {
          "x": "{{steps.selectedTargetResult.value.tapX}}",
          "y": "{{steps.selectedTargetResult.value.tapY}}"
        }
      }
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "steps.selectedTargetResult.found", "truthy": false },
      "arguments": {
        "target": { "using": "xpath", "value": "//XCUIElementTypeCell[starts-with(@name, 'AppStore.shelfItem.searchResult')]", "index": "{{result_index}}" }
      }
    },
    {
      "tool": "ios.ui.extract_text",
      "saveAs": "dismissButtons",
      "arguments": {
        "query": { "type": "XCUIElementTypeButton", "name": "AppStore.dismissButton", "max": 2 },
        "limit": 2,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "util.list.first",
      "saveAs": "dismissFirst",
      "arguments": { "list": "{{steps.dismissButtons.texts}}" }
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "steps.dismissFirst.found", "truthy": true },
      "arguments": { "target": { "using": "accessibility id", "value": "AppStore.dismissButton" } }
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "steps.dismissFirst.found", "truthy": true },
      "arguments": {
        "point": {
          "x": "{{steps.selectedTargetResult.value.tapX}}",
          "y": "{{steps.selectedTargetResult.value.tapY}}"
        }
      }
    },
    {
      "tool": "ios.action.wait",
      "arguments": {
        "target": { "using": "xpath", "value": "//XCUIElementTypeCell[starts-with(@name, 'AppStore.shelfItem.productTopLockup')]" },
        "timeoutMs": 30000
      },
      "retries": 1
    },
    { "tool": "ios.ui.screenshot", "arguments": {}, "saveAs": "shot1" },
    { "tool": "ios.action.scroll", "arguments": { "direction": "left", "distance": 0.6 } },
    { "tool": "ios.ui.screenshot", "arguments": {}, "saveAs": "shot2" },
    { "tool": "ios.action.scroll", "arguments": { "direction": "left", "distance": 0.6 } },
    { "tool": "ios.ui.screenshot", "arguments": {}, "saveAs": "shot3" },
    { "tool": "ios.action.scroll", "arguments": { "direction": "left", "distance": 0.6 } },
    { "tool": "ios.ui.screenshot", "arguments": {}, "saveAs": "shot4" },
    { "tool": "ios.action.scroll", "arguments": { "direction": "left", "distance": 0.6 } },
    { "tool": "ios.ui.screenshot", "arguments": {}, "saveAs": "shot5" }
  ],
  "output": {
    "query": "{{query}}",
    "result_index": "{{result_index}}",
    "matchedResultRank": "{{steps.targetResultRank.rank}}",
    "matchedResultIndex": "{{steps.targetResultRank.index}}",
    "selectedResult": "{{steps.selectedTargetResult.value}}",
    "shots": ["{{steps.shot1}}", "{{steps.shot2}}", "{{steps.shot3}}", "{{steps.shot4}}", "{{steps.shot5}}"]
  }
}
