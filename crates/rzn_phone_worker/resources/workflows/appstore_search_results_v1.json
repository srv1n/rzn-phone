{
  "schema_version": "rzn.mobile.workflow.v1",
  "name": "appstore.search_results",
  "version": "1.1.2",
  "description": "Submit an App Store search query, capture ordered result rows, and compute optional observed rank (read-only).",
  "capability": {
    "family": "extract",
    "intent": "search_results",
    "surface": "native_app",
    "mutating": false
  },
  "inputs": {
    "query": {
      "type": "string",
      "required": true,
      "description": "The App Store query to submit.",
      "example": "voice notes",
      "group": "core"
    },
    "target_app_name": {
      "type": "string",
      "description": "Optional exact app name to rank against the observed result list.",
      "example": "Voicenotes AI Notes & Meetings",
      "group": "core"
    },
    "limit": {
      "type": "integer",
      "default": 10,
      "min": 1,
      "max": 50,
      "description": "Maximum number of result rows to return.",
      "example": 10,
      "group": "advanced"
    },
    "maxScrolls": {
      "type": "integer",
      "default": 5,
      "min": 0,
      "max": 12,
      "description": "How many extra result-list scrolls to spend while collecting rows.",
      "example": 5,
      "group": "advanced"
    },
    "submit_mode": {
      "type": "string",
      "default": "suggestion",
      "description": "How to submit the search: tap the suggestion row or press the keyboard search key.",
      "example": "suggestion",
      "group": "advanced"
    },
    "typing_mode": {
      "type": "string",
      "default": "full",
      "description": "Whether to type the full query at once or character by character.",
      "example": "full",
      "group": "advanced"
    },
    "country": {
      "type": "string",
      "description": "Optional App Store storefront country code, such as us.",
      "example": "us",
      "group": "advanced"
    },
    "locale": {
      "type": "string",
      "description": "Optional locale override, such as en_US.",
      "example": "en_US",
      "group": "advanced"
    }
  },
  "help": {
    "when_to_use": "Use this when you need real App Store ranking evidence, not search scraped from the web.",
    "returns": "Ordered App Store result rows plus optional observed rank for a named target app.",
    "examples": [
      {
        "label": "Rank a target app",
        "description": "Search the App Store and compute where one specific app appears.",
        "args": {
          "query": "voice notes",
          "target_app_name": "Voicenotes AI Notes & Meetings",
          "limit": 5
        }
      },
      {
        "label": "Broad result capture",
        "description": "Pull more rows for audit or competitive analysis.",
        "args": {
          "query": "habit tracker",
          "limit": 15,
          "maxScrolls": 6
        }
      }
    ]
  },
  "notes": [
    "Read-only workflow: opens App Store Search and scrapes visible rows.",
    "Includes compact snapshot + screenshot of the top fold for debugging.",
    "Uses bounded scrolling for top-N extraction."
  ],
  "steps": [
    {
      "tool": "ios.appium.ensure",
      "arguments": {}
    },
    {
      "tool": "ios.session.create",
      "arguments": {
        "udid": "{{udid}}",
        "kind": "native_app",
        "bundleId": "com.apple.AppStore",
        "replaceExisting": true,
        "noReset": true,
        "showXcodeLog": "{{showXcodeLog}}",
        "allowProvisioningUpdates": "{{allowProvisioningUpdates}}",
        "allowProvisioningDeviceRegistration": "{{allowProvisioningDeviceRegistration}}",
        "sessionCreateTimeoutMs": "{{sessionCreateTimeoutMs}}",
        "wdaLocalPort": "{{wdaLocalPort}}",
        "wdaLaunchTimeoutMs": "{{wdaLaunchTimeoutMs}}",
        "wdaConnectionTimeoutMs": "{{wdaConnectionTimeoutMs}}",
        "signing": {
          "xcodeOrgId": "{{xcodeOrgId}}",
          "xcodeSigningId": "{{xcodeSigningId}}",
          "updatedWDABundleId": "{{updatedWDABundleId}}"
        }
      }
    },
    {
      "tool": "ios.action.wait",
      "arguments": {
        "target": {
          "using": "accessibility id",
          "value": "AppStore.tabBar.search"
        },
        "timeoutMs": 30000
      },
      "retries": 1
    },
    {
      "tool": "ios.action.tap",
      "arguments": {
        "target": {
          "using": "accessibility id",
          "value": "AppStore.tabBar.search"
        }
      }
    },
    {
      "tool": "ios.action.tap",
      "arguments": {
        "target": {
          "using": "accessibility id",
          "value": "AppStore.searchField"
        }
      }
    },
    {
      "tool": "ios.action.type",
      "when": {
        "var": "submit_mode",
        "equals": "suggestion"
      },
      "arguments": {
        "target": {
          "using": "accessibility id",
          "value": "AppStore.searchField"
        },
        "text": "{{query}}",
        "clearFirst": true
      }
    },
    {
      "tool": "ios.action.type",
      "when": {
        "var": "submit_mode",
        "equals": "keyboard"
      },
      "arguments": {
        "target": {
          "using": "accessibility id",
          "value": "AppStore.searchField"
        },
        "text": "{{query}}",
        "clearFirst": true,
        "pressEnter": true
      }
    },
    {
      "tool": "ios.ui.extract_text",
      "when": {
        "var": "submit_mode",
        "equals": "keyboard"
      },
      "saveAs": "keyboardHints",
      "arguments": {
        "query": {
          "type": "XCUIElementTypeCell",
          "ancestorName": "AppStore.searchHints",
          "max": 2
        },
        "limit": 2,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "util.list.first",
      "when": {
        "var": "submit_mode",
        "equals": "keyboard"
      },
      "saveAs": "keyboardHintFirst",
      "arguments": {
        "list": "{{steps.keyboardHints.texts}}"
      }
    },
    {
      "tool": "ios.action.tap",
      "when": {
        "var": "steps.keyboardHintFirst.found",
        "truthy": true
      },
      "arguments": {
        "target": {
          "using": "xpath",
          "value": "//XCUIElementTypeCollectionView[@name='AppStore.searchHints']//XCUIElementTypeCell[1]"
        }
      }
    },
    {
      "tool": "ios.action.wait",
      "when": {
        "var": "submit_mode",
        "equals": "suggestion"
      },
      "arguments": {
        "target": {
          "using": "xpath",
          "value": "//XCUIElementTypeCollectionView[@name='AppStore.searchHints']//XCUIElementTypeCell[1]"
        },
        "timeoutMs": 10000
      },
      "retries": 1
    },
    {
      "tool": "ios.action.tap",
      "when": {
        "var": "submit_mode",
        "equals": "suggestion"
      },
      "arguments": {
        "target": {
          "using": "xpath",
          "value": "//XCUIElementTypeCollectionView[@name='AppStore.searchHints']//XCUIElementTypeCell[1]"
        }
      }
    },
    {
      "tool": "ios.action.wait",
      "arguments": {
        "target": {
          "using": "xpath",
          "value": "//XCUIElementTypeCell[starts-with(@name, 'AppStore.shelfItem.searchResult')]"
        },
        "timeoutMs": 30000
      },
      "retries": 1
    },
    {
      "tool": "ios.ui.observe_compact",
      "arguments": {
        "nodeFilter": "all",
        "maxNodes": 220
      },
      "saveAs": "compactSnapshot"
    },
    {
      "tool": "ios.ui.screenshot",
      "arguments": {},
      "saveAs": "screenshot"
    },
    {
      "tool": "ios.ui.source",
      "arguments": {},
      "saveAs": "uiSource"
    },
    {
      "tool": "ios.ui.extract_rows",
      "saveAs": "results",
      "arguments": {
        "row": {
          "type": "XCUIElementTypeCell",
          "namePrefix": "AppStore.shelfItem.searchResult"
        },
        "primary": {
          "type": "XCUIElementTypeButton",
          "attr": "label",
          "pick": "longest"
        },
        "split": {
          "delimiter": ",",
          "fields": [
            "name",
            "subtitle",
            "developer"
          ],
          "skipMetricLike": true
        },
        "limit": "{{limit}}",
        "maxScrolls": "{{maxScrolls}}",
        "scroll": {
          "direction": "down",
          "distance": 0.6,
          "settleMs": 350
        }
      }
    },
    {
      "tool": "util.rank_by_name",
      "saveAs": "rank",
      "when": {
        "var": "target_app_name",
        "truthy": true
      },
      "arguments": {
        "items": "{{steps.results.rows}}",
        "field": "name",
        "target": "{{target_app_name}}"
      }
    }
  ],
  "output": {
    "query": "{{query}}",
    "results": "{{steps.results.rows}}",
    "resultCount": "{{steps.results.rowCount}}",
    "observed_rank": "{{steps.rank.rank}}",
    "screenshot": "{{steps.screenshot}}",
    "uiSource": "{{steps.uiSource}}",
    "compactSnapshot": "{{steps.compactSnapshot}}"
  }
}
