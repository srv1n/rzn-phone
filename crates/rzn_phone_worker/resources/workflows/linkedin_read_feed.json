{
  "name": "linkedin/read_feed",
  "version": "1.0.3",
  "description": "Open LinkedIn Home feed and extract top visible feed cards (read-only).",
  "capability": {
    "family": "extract",
    "intent": "read_feed",
    "surface": "native_app",
    "mutating": false
  },
  "inputs": {
    "limit": { "type": "integer", "default": 5, "min": 1, "max": 25 },
    "maxNodes": { "type": "integer", "default": 220, "min": 80, "max": 400 }
  },
  "notes": [
    "Read-only workflow for LinkedIn Home feed.",
    "Best-effort cleanup handles common overlays (left nav panel, Premium upsell, open composer draft).",
    "Feed card payloads are raw cell labels and can be long."
  ],
  "steps": [
    { "tool": "ios.appium.ensure", "arguments": {} },
    {
      "tool": "ios.session.create",
      "arguments": {
        "udid": "{{udid}}",
        "kind": "native_app",
        "bundleId": "com.linkedin.LinkedIn",
        "replaceExisting": true,
        "noReset": true,
        "showXcodeLog": "{{showXcodeLog}}",
        "allowProvisioningUpdates": "{{allowProvisioningUpdates}}",
        "allowProvisioningDeviceRegistration": "{{allowProvisioningDeviceRegistration}}",
        "sessionCreateTimeoutMs": "{{sessionCreateTimeoutMs}}",
        "wdaLocalPort": "{{wdaLocalPort}}",
        "wdaLaunchTimeoutMs": "{{wdaLaunchTimeoutMs}}",
        "wdaConnectionTimeoutMs": "{{wdaConnectionTimeoutMs}}",
        "signing": {
          "xcodeOrgId": "{{xcodeOrgId}}",
          "xcodeSigningId": "{{xcodeSigningId}}",
          "updatedWDABundleId": "{{updatedWDABundleId}}"
        }
      }
    },
    { "tool": "ios.app.activate", "arguments": { "bundleId": "com.linkedin.LinkedIn", "terminateFirst": true } },
    { "tool": "util.sleep", "arguments": { "minMs": 3500, "maxMs": 4500 } },
    {
      "tool": "ios.ui.extract_text",
      "saveAs": "menuOverlay",
      "arguments": {
        "query": { "type": "XCUIElementTypeButton", "name": "NavPanelViewControllerScrimViewA11yID", "max": 1 },
        "limit": 1,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "util.list.length",
      "saveAs": "menuOverlayCount",
      "arguments": { "list": "{{steps.menuOverlay.texts}}" }
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "steps.menuOverlayCount.count", "truthy": true },
      "arguments": { "target": { "using": "accessibility id", "value": "NavPanelViewControllerScrimViewA11yID" } }
    },
    {
      "tool": "ios.ui.extract_text",
      "saveAs": "premiumClose",
      "arguments": {
        "query": { "type": "XCUIElementTypeButton", "name": "LINPremiumFeedFullPageTakeoverUpsellCloseButtonViewA11yID", "max": 1 },
        "limit": 1,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "util.list.length",
      "saveAs": "premiumCloseCount",
      "arguments": { "list": "{{steps.premiumClose.texts}}" }
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "steps.premiumCloseCount.count", "truthy": true },
      "arguments": { "target": { "using": "accessibility id", "value": "LINPremiumFeedFullPageTakeoverUpsellCloseButtonViewA11yID" } }
    },
    {
      "tool": "ios.ui.extract_text",
      "saveAs": "premiumNoThanks",
      "arguments": {
        "query": { "type": "XCUIElementTypeButton", "name": "LINPremiumFeedFullPageTakeoverUpsellCancelCTAButtonA11yID", "max": 1 },
        "limit": 1,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "util.list.length",
      "saveAs": "premiumNoThanksCount",
      "arguments": { "list": "{{steps.premiumNoThanks.texts}}" }
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "steps.premiumNoThanksCount.count", "truthy": true },
      "arguments": { "target": { "using": "accessibility id", "value": "LINPremiumFeedFullPageTakeoverUpsellCancelCTAButtonA11yID" } }
    },
    {
      "tool": "ios.ui.extract_text",
      "saveAs": "composeCancel",
      "arguments": {
        "query": { "type": "XCUIElementTypeButton", "name": "13603", "max": 1 },
        "limit": 1,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "util.list.length",
      "saveAs": "composeCancelCount",
      "arguments": { "list": "{{steps.composeCancel.texts}}" }
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "steps.composeCancelCount.count", "truthy": true },
      "arguments": { "target": { "using": "accessibility id", "value": "13603" } }
    },
    {
      "tool": "ios.ui.extract_text",
      "saveAs": "discardButtons",
      "arguments": {
        "query": { "type": "XCUIElementTypeButton", "labelContains": "Discard", "max": 1 },
        "limit": 1,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "util.list.length",
      "saveAs": "discardButtonsCount",
      "arguments": { "list": "{{steps.discardButtons.texts}}" }
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "steps.discardButtonsCount.count", "truthy": true },
      "arguments": {
        "target": {
          "using": "-ios predicate string",
          "value": "label CONTAINS 'Discard' OR label CONTAINS 'Delete draft' OR label CONTAINS 'Discard post'"
        }
      }
    },
    {
      "tool": "ios.ui.extract_text",
      "saveAs": "sheetGrabber",
      "arguments": {
        "query": { "type": "XCUIElementTypeButton", "name": "Sheet Grabber", "max": 1 },
        "limit": 1,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "util.list.length",
      "saveAs": "sheetGrabberCount",
      "arguments": { "list": "{{steps.sheetGrabber.texts}}" }
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "steps.sheetGrabberCount.count", "truthy": true },
      "arguments": { "target": { "using": "accessibility id", "value": "Sheet Grabber" } }
    },
    {
      "tool": "ios.action.wait",
      "arguments": {
        "target": {
          "using": "-ios predicate string",
          "value": "name == 'VoyagerFeed.FeedSDUIView' OR name == 'Home' OR label == 'Home'"
        },
        "timeoutMs": 30000
      },
      "retries": 1
    },
    {
      "tool": "ios.ui.extract_rows",
      "saveAs": "feedCards",
      "arguments": {
        "row": { "type": "XCUIElementTypeCell" },
        "primary": {
          "type": "XCUIElementTypeStaticText",
          "attr": "label",
          "pick": "longest"
        },
        "fields": [
          {
            "name": "author",
            "query": { "type": "XCUIElementTypeStaticText", "max": 1 },
            "attr": "label",
            "pick": "first"
          },
          {
            "name": "commentAction",
            "query": { "type": "XCUIElementTypeButton", "label": "Comment", "max": 1 },
            "attr": "label",
            "pick": "first"
          }
        ],
        "limit": "{{limit}}",
        "order": "y"
      }
    },
    {
      "tool": "util.list.length",
      "saveAs": "feedCardsCount",
      "arguments": { "list": "{{steps.feedCards.rows}}" }
    },
    { "tool": "ios.ui.screenshot", "arguments": {}, "saveAs": "screenshot" },
    { "tool": "ios.ui.source", "arguments": {}, "saveAs": "uiSource" },
    { "tool": "ios.ui.observe_compact", "arguments": { "nodeFilter": "all", "maxNodes": "{{maxNodes}}" }, "saveAs": "compactSnapshot" }
  ],
  "output": {
    "cards": "{{steps.feedCards.rows}}",
    "cardCount": "{{steps.feedCardsCount.count}}",
    "screenshot": "{{steps.screenshot}}",
    "uiSource": "{{steps.uiSource}}",
    "compactSnapshot": "{{steps.compactSnapshot}}"
  }
}
