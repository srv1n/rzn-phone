{
  "name": "linkedin/update_latest_post",
  "version": "1.0.4",
  "description": "Navigate to your LinkedIn posts, open the latest post editor, and optionally save edits (commit-gated).",
  "capability": {
    "family": "interact",
    "intent": "update_post",
    "surface": "native_app",
    "mutating": true
  },
  "inputs": {
    "updated_text": { "type": "string", "required": true },
    "execute_update": { "type": "boolean", "default": false },
    "post_index": { "type": "integer", "default": 0, "min": 0, "max": 20 },
    "max_profile_scrolls": { "type": "integer", "default": 6, "min": 0, "max": 20 },
    "profile_posts_scroll_distance": { "type": "number", "default": 0.62, "min": 0.2, "max": 0.9 },
    "home_tab_id": { "type": "string", "default": "12000" },
    "profile_back_button_id": { "type": "string", "default": "100" },
    "menu_button_id": { "type": "string", "default": "5600" },
    "profile_button_id": { "type": "string", "default": "NavPanelIdentityViewProfileImageViewA11yID" },
    "show_all_posts_label_contains": { "type": "string", "default": "Show all posts" },
    "show_all_posts_predicate": { "type": "string", "default": "label CONTAINS 'Show all posts' OR label CONTAINS 'Show all activity'" },
    "profile_activity_predicate": { "type": "string", "default": "label == 'Comment' OR name == 'Comment' OR label == 'Activity' OR label CONTAINS 'Posts you share will be displayed here.'" },
    "empty_posts_label_contains": { "type": "string", "default": "Posts you share will be displayed here." },
    "post_card_predicate": { "type": "string", "default": "name CONTAINS 'feedUpdateCardA11yIDurn:li:fsd_update'" },
    "post_menu_predicate": { "type": "string", "default": "label == 'More' OR name == 'More' OR name CONTAINS 'overflow'" },
    "edit_action_predicate": { "type": "string", "default": "label CONTAINS 'Edit post' OR label == 'Edit'" },
    "save_action_predicate": { "type": "string", "default": "label == 'Save' OR label == 'Done' OR label == 'Post' OR name == '13602'" },
    "editor_field_id": { "type": "string", "default": "13617" },
    "maxNodes": { "type": "integer", "default": 240, "min": 80, "max": 420 }
  },
  "notes": [
    "This workflow is parameterized because post menu/edit selectors vary by account, locale, and app build.",
    "By default it prepares and captures artifacts before saving.",
    "Set args.execute_update=true and run with commit=true to apply edits."
  ],
  "steps": [
    { "tool": "ios.appium.ensure", "arguments": {} },
    {
      "tool": "ios.session.create",
      "arguments": {
        "udid": "{{udid}}",
        "kind": "native_app",
        "bundleId": "com.linkedin.LinkedIn",
        "replaceExisting": true,
        "noReset": true,
        "showXcodeLog": "{{showXcodeLog}}",
        "allowProvisioningUpdates": "{{allowProvisioningUpdates}}",
        "allowProvisioningDeviceRegistration": "{{allowProvisioningDeviceRegistration}}",
        "sessionCreateTimeoutMs": "{{sessionCreateTimeoutMs}}",
        "wdaLocalPort": "{{wdaLocalPort}}",
        "wdaLaunchTimeoutMs": "{{wdaLaunchTimeoutMs}}",
        "wdaConnectionTimeoutMs": "{{wdaConnectionTimeoutMs}}",
        "signing": {
          "xcodeOrgId": "{{xcodeOrgId}}",
          "xcodeSigningId": "{{xcodeSigningId}}",
          "updatedWDABundleId": "{{updatedWDABundleId}}"
        }
      }
    },
    {
      "tool": "ios.app.activate",
      "arguments": {
        "bundleId": "com.linkedin.LinkedIn",
        "terminateFirst": true
      }
    },
    { "tool": "util.sleep", "arguments": { "minMs": 1500, "maxMs": 1500 } },
    {
      "tool": "ios.ui.extract_text",
      "saveAs": "menuOverlay",
      "arguments": {
        "query": { "type": "XCUIElementTypeButton", "name": "NavPanelViewControllerScrimViewA11yID", "max": 1 },
        "limit": 1,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "util.list.length",
      "saveAs": "menuOverlayCount",
      "arguments": { "list": "{{steps.menuOverlay.texts}}" }
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "steps.menuOverlayCount.count", "truthy": true },
      "arguments": { "target": { "using": "accessibility id", "value": "NavPanelViewControllerScrimViewA11yID" } }
    },
    {
      "tool": "ios.ui.extract_text",
      "saveAs": "composeCancel",
      "arguments": {
        "query": { "type": "XCUIElementTypeButton", "name": "13603", "max": 1 },
        "limit": 1,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "util.list.length",
      "saveAs": "composeCancelCount",
      "arguments": { "list": "{{steps.composeCancel.texts}}" }
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "steps.composeCancelCount.count", "truthy": true },
      "arguments": { "target": { "using": "accessibility id", "value": "13603" } }
    },
    {
      "tool": "ios.ui.extract_text",
      "saveAs": "discardButtons",
      "arguments": {
        "query": { "type": "XCUIElementTypeButton", "labelContains": "Discard", "max": 1 },
        "limit": 1,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "util.list.length",
      "saveAs": "discardButtonsCount",
      "arguments": { "list": "{{steps.discardButtons.texts}}" }
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "steps.discardButtonsCount.count", "truthy": true },
      "arguments": {
        "target": {
          "using": "-ios predicate string",
          "value": "label CONTAINS 'Discard' OR label CONTAINS 'Delete draft' OR label CONTAINS 'Discard post'"
        }
      }
    },
    {
      "tool": "ios.ui.extract_text",
      "saveAs": "homeTab",
      "arguments": {
        "query": { "type": "XCUIElementTypeButton", "label": "Home", "max": 1 },
        "limit": 1,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "util.list.length",
      "saveAs": "homeTabCount",
      "arguments": { "list": "{{steps.homeTab.texts}}" }
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "steps.homeTabCount.count", "truthy": true },
      "arguments": { "target": { "using": "accessibility id", "value": "{{home_tab_id}}" } }
    },
    { "tool": "util.sleep", "arguments": { "minMs": 1200, "maxMs": 1200 } },
    {
      "tool": "ios.ui.extract_text",
      "saveAs": "profileMarkers",
      "arguments": {
        "query": { "type": "XCUIElementTypeButton", "labelContains": "Add section", "max": 1 },
        "limit": 1,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "ios.ui.extract_text",
      "saveAs": "profileInsightsHeader",
      "arguments": {
        "query": { "type": "XCUIElementTypeStaticText", "label": "Profile appearances", "max": 1 },
        "limit": 1,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "util.list.length",
      "saveAs": "profileInsightsHeaderCount",
      "arguments": { "list": "{{steps.profileInsightsHeader.texts}}" }
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "steps.profileInsightsHeaderCount.count", "truthy": true },
      "arguments": { "target": { "using": "accessibility id", "value": "{{profile_back_button_id}}" } }
    },
    {
      "tool": "ios.ui.extract_text",
      "saveAs": "profileMarkers",
      "arguments": {
        "query": { "type": "XCUIElementTypeButton", "labelContains": "Add section", "max": 1 },
        "limit": 1,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "util.list.length",
      "saveAs": "profileMarkersCount",
      "arguments": { "list": "{{steps.profileMarkers.texts}}" }
    },
    {
      "tool": "ios.action.wait",
      "when": { "var": "steps.profileMarkersCount.count", "equals": 0 },
      "arguments": {
        "target": { "using": "accessibility id", "value": "{{menu_button_id}}" },
        "timeoutMs": 20000
      },
      "retries": 1
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "steps.profileMarkersCount.count", "equals": 0 },
      "arguments": { "target": { "using": "accessibility id", "value": "{{menu_button_id}}" } }
    },
    {
      "tool": "ios.action.wait",
      "when": { "var": "steps.profileMarkersCount.count", "equals": 0 },
      "arguments": {
        "target": { "using": "accessibility id", "value": "{{profile_button_id}}" },
        "timeoutMs": 20000
      },
      "retries": 1
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "steps.profileMarkersCount.count", "equals": 0 },
      "arguments": { "target": { "using": "accessibility id", "value": "{{profile_button_id}}" } }
    },
    {
      "tool": "ios.action.wait",
      "arguments": {
        "target": {
          "using": "-ios predicate string",
          "value": "label CONTAINS 'followers' OR label CONTAINS 'connections' OR label CONTAINS 'posts' OR label CONTAINS 'activity' OR label == 'Add section' OR label == 'Enhance profile' OR label == 'Open to'"
        },
        "timeoutMs": 30000
      },
      "retries": 1
    },
    {
      "tool": "ios.ui.extract_text",
      "saveAs": "dismissPopupRegion",
      "arguments": {
        "query": { "type": "XCUIElementTypeOther", "labelContains": "dismiss popup", "max": 1 },
        "limit": 1,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "util.list.length",
      "saveAs": "dismissPopupRegionCount",
      "arguments": { "list": "{{steps.dismissPopupRegion.texts}}" }
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "steps.dismissPopupRegionCount.count", "truthy": true },
      "arguments": {
        "target": {
          "using": "-ios predicate string",
          "value": "label CONTAINS 'dismiss popup' OR name == 'PopoverDismissRegion'"
        }
      }
    },
    {
      "tool": "ios.ui.extract_text",
      "saveAs": "showAllPostsButtons",
      "arguments": {
        "query": { "type": "XCUIElementTypeButton", "labelContains": "{{show_all_posts_label_contains}}", "max": 1 },
        "limit": 1,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "util.list.length",
      "saveAs": "showAllPostsCount",
      "arguments": { "list": "{{steps.showAllPostsButtons.texts}}" }
    },
    {
      "tool": "ios.action.tap",
      "when": { "var": "steps.showAllPostsCount.count", "truthy": true },
      "arguments": {
        "target": { "using": "-ios predicate string", "value": "{{show_all_posts_predicate}}" }
      }
    },
    {
      "tool": "ios.action.scroll_until",
      "arguments": {
        "target": {
          "using": "-ios predicate string",
          "value": "{{profile_activity_predicate}}"
        },
        "direction": "down",
        "distance": "{{profile_posts_scroll_distance}}",
        "maxScrolls": "{{max_profile_scrolls}}",
        "timeoutMs": 60000,
        "settleMs": 450
      }
    },
    {
      "tool": "ios.ui.extract_text",
      "saveAs": "emptyPostsState",
      "arguments": {
        "query": { "type": "XCUIElementTypeStaticText", "labelContains": "{{empty_posts_label_contains}}", "max": 1 },
        "limit": 1,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "util.list.length",
      "saveAs": "emptyPostsStateCount",
      "arguments": { "list": "{{steps.emptyPostsState.texts}}" }
    },
    {
      "tool": "util.fail",
      "when": { "var": "steps.emptyPostsStateCount.count", "truthy": true },
      "arguments": {
        "message": "LinkedIn profile has no posts to update yet.",
        "details": {
          "reason": "no_posts",
          "surface": "linkedin.profile.activity"
        }
      }
    },
    {
      "tool": "ios.action.scroll_until",
      "arguments": {
        "target": {
          "using": "-ios predicate string",
          "value": "{{post_menu_predicate}}",
          "index": "{{post_index}}"
        },
        "direction": "down",
        "distance": 0.55,
        "maxScrolls": "{{max_profile_scrolls}}",
        "timeoutMs": 60000,
        "settleMs": 350
      }
    },
    {
      "tool": "ios.action.wait",
      "arguments": {
        "target": {
          "using": "-ios predicate string",
          "value": "{{post_menu_predicate}}",
          "index": "{{post_index}}"
        },
        "timeoutMs": 15000
      },
      "retries": 1
    },
    {
      "tool": "ios.action.tap",
      "arguments": {
        "target": {
          "using": "-ios predicate string",
          "value": "{{post_menu_predicate}}",
          "index": "{{post_index}}"
        }
      }
    },
    {
      "tool": "ios.action.wait",
      "arguments": {
        "target": { "using": "-ios predicate string", "value": "{{edit_action_predicate}}" },
        "timeoutMs": 15000
      },
      "retries": 1
    },
    {
      "tool": "ios.action.tap",
      "arguments": {
        "target": { "using": "-ios predicate string", "value": "{{edit_action_predicate}}" }
      }
    },
    {
      "tool": "ios.action.wait",
      "arguments": {
        "target": { "using": "accessibility id", "value": "{{editor_field_id}}" },
        "timeoutMs": 25000
      },
      "retries": 1
    },
    {
      "tool": "ios.action.type",
      "arguments": {
        "target": { "using": "accessibility id", "value": "{{editor_field_id}}" },
        "text": "{{updated_text}}",
        "clearFirst": true
      }
    },
    { "tool": "ios.ui.screenshot", "arguments": {}, "saveAs": "draftScreenshot" },
    { "tool": "ios.ui.source", "arguments": {}, "saveAs": "draftUiSource" },
    { "tool": "ios.ui.observe_compact", "arguments": { "nodeFilter": "all", "maxNodes": "{{maxNodes}}" }, "saveAs": "draftCompactSnapshot" },
    {
      "tool": "ios.action.tap",
      "when": { "var": "execute_update", "truthy": true },
      "requiresCommit": true,
      "arguments": {
        "target": { "using": "-ios predicate string", "value": "{{save_action_predicate}}" }
      }
    }
  ],
  "output": {
    "requestedUpdate": "{{execute_update}}",
    "draftScreenshot": "{{steps.draftScreenshot}}",
    "draftUiSource": "{{steps.draftUiSource}}",
    "draftCompactSnapshot": "{{steps.draftCompactSnapshot}}"
  }
}
