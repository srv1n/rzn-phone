{
  "name": "google_maps/open_place",
  "version": "1.0.1",
  "description": "Open Google Maps, search for a place, and capture the place sheet plus summary text.",
  "required_variables": ["query"],
  "capability": {
    "family": "navigate",
    "intent": "open_place",
    "surface": "native_app",
    "mutating": false
  },
  "inputs": {
    "query": {
      "type": "string",
      "required": true,
      "description": "Place, address, or landmark to open in Google Maps.",
      "example": "Blue Bottle Coffee SoHo",
      "group": "core"
    },
    "maxNodes": {
      "type": "integer",
      "default": 220,
      "min": 80,
      "max": 420,
      "description": "UI tree depth cap for extraction. Leave it alone unless you are debugging parser misses.",
      "example": 220,
      "group": "internal"
    }
  },
  "help": {
    "when_to_use": "Use this when you need the real Google Maps place sheet and not a web search approximation.",
    "returns": "Place title, summary text, and proof artifacts from the opened Google Maps place sheet.",
    "parameters": {
      "query": {
        "description": "Place, address, or landmark to open in Google Maps.",
        "example": "Blue Bottle Coffee SoHo",
        "group": "core",
        "structure": "Specific place, address, or landmark text."
      },
      "maxNodes": {
        "description": "UI tree depth cap for extraction. Leave it alone unless you are debugging parser misses.",
        "example": 220,
        "group": "internal"
      }
    },
    "examples": [
      {
        "label": "Open a place sheet",
        "description": "Best for quick checks on hours, rating, address, or category.",
        "args": {
          "query": "Blue Bottle Coffee SoHo"
        }
      }
    ]
  },
  "notes": [
    "Read-only workflow.",
    "Validated against the connected iPhone with Google Maps bundle id com.google.Maps.",
    "This targets the exact-query fast path where Maps opens a place sheet directly."
  ],
  "steps": [
    { "tool": "ios.appium.ensure", "arguments": {} },
    {
      "tool": "ios.session.create",
      "arguments": {
        "udid": "{{udid}}",
        "kind": "native_app",
        "bundleId": "com.google.Maps",
        "replaceExisting": true,
        "noReset": true,
        "showXcodeLog": "{{showXcodeLog}}",
        "allowProvisioningUpdates": "{{allowProvisioningUpdates}}",
        "allowProvisioningDeviceRegistration": "{{allowProvisioningDeviceRegistration}}",
        "sessionCreateTimeoutMs": "{{sessionCreateTimeoutMs}}",
        "wdaLocalPort": "{{wdaLocalPort}}",
        "wdaLaunchTimeoutMs": "{{wdaLaunchTimeoutMs}}",
        "wdaConnectionTimeoutMs": "{{wdaConnectionTimeoutMs}}",
        "signing": {
          "xcodeOrgId": "{{xcodeOrgId}}",
          "xcodeSigningId": "{{xcodeSigningId}}",
          "updatedWDABundleId": "{{updatedWDABundleId}}"
        }
      }
    },
    {
      "tool": "ios.app.activate",
      "arguments": {
        "bundleId": "com.google.Maps",
        "terminateFirst": true
      }
    },
    {
      "tool": "ios.action.wait",
      "arguments": {
        "target": { "using": "accessibility id", "value": "SearchHeaderSearchTxtView" },
        "timeoutMs": 30000
      },
      "retries": 1
    },
    { "tool": "util.sleep", "arguments": { "minMs": 400, "maxMs": 900 } },
    {
      "tool": "ios.action.tap",
      "arguments": {
        "target": { "using": "accessibility id", "value": "SearchHeaderSearchTxtView" }
      }
    },
    {
      "tool": "ios.action.type",
      "arguments": {
        "target": { "using": "accessibility id", "value": "SearchHeaderSearchTxtView" },
        "text": "{{query}}",
        "clearFirst": true,
        "pressEnter": true
      }
    },
    {
      "tool": "ios.action.wait",
      "arguments": {
        "target": {
          "using": "xpath",
          "value": "(//XCUIElementTypeButton[@name='{{query}}' or @label='{{query}}'] | //XCUIElementTypeCell//XCUIElementTypeButton[contains(@name,'{{query}}') or contains(@label,'{{query}}')])[1]"
        },
        "timeoutMs": 15000
      },
      "retries": 1
    },
    { "tool": "util.sleep", "arguments": { "minMs": 400, "maxMs": 900 } },
    {
      "tool": "ios.action.tap",
      "arguments": {
        "target": {
          "using": "xpath",
          "value": "(//XCUIElementTypeButton[@name='{{query}}' or @label='{{query}}'] | //XCUIElementTypeCell//XCUIElementTypeButton[contains(@name,'{{query}}') or contains(@label,'{{query}}')])[1]"
        }
      }
    },
    { "tool": "util.sleep", "arguments": { "minMs": 1200, "maxMs": 2200 } },
    {
      "tool": "ios.action.wait",
      "arguments": {
        "target": { "using": "xpath", "value": "//XCUIElementTypeButton[@name='Directions' or @label='Directions']" },
        "timeoutMs": 20000
      },
      "retries": 1
    },
    {
      "tool": "ios.ui.extract_text",
      "saveAs": "placeTitleCandidates",
      "arguments": {
        "query": { "type": "XCUIElementTypeButton", "nameContains": "{{query}}", "max": 6 },
        "limit": 3,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "util.list.first",
      "saveAs": "placeTitle",
      "arguments": {
        "list": "{{steps.placeTitleCandidates.texts}}",
        "field": "text"
      }
    },
    {
      "tool": "ios.ui.extract_text",
      "saveAs": "otherTexts",
      "arguments": {
        "query": { "type": "XCUIElementTypeOther", "max": 20 },
        "limit": 10,
        "unique": true,
        "order": "y"
      }
    },
    {
      "tool": "ios.element.attribute",
      "saveAs": "summaryLine",
      "arguments": {
        "target": {
          "using": "xpath",
          "value": "//XCUIElementTypeOther[contains(@name,'reviews') or contains(@label,'reviews') or contains(@name,' km') or contains(@label,' km') or contains(@name,' min') or contains(@label,' min') or contains(@name,'Driving') or contains(@label,'Driving') or contains(@name,'Walking') or contains(@label,'Walking') or contains(@name,'Transit') or contains(@label,'Transit')][1]"
        },
        "name": "name"
      }
    },
    {
      "tool": "util.list.nth",
      "saveAs": "detailsLine",
      "arguments": { "list": "{{steps.otherTexts.texts}}", "index": 4, "field": "text" }
    },
    {
      "tool": "ios.ui.extract_text",
      "saveAs": "buttonTexts",
      "arguments": {
        "query": { "type": "XCUIElementTypeButton", "max": 20 },
        "limit": 12,
        "unique": true,
        "order": "y"
      }
    },
    { "tool": "ios.ui.screenshot", "arguments": {}, "saveAs": "screenshot" },
    { "tool": "ios.ui.source", "arguments": {}, "saveAs": "uiSource" },
    {
      "tool": "ios.ui.observe_compact",
      "arguments": { "nodeFilter": "all", "maxNodes": "{{maxNodes}}" },
      "saveAs": "compactSnapshot"
    }
  ],
  "output": {
    "query": "{{query}}",
    "title": "{{steps.placeTitle.value}}",
    "summaryLine": "{{steps.summaryLine.value}}",
    "detailsLine": "{{steps.detailsLine.value}}",
    "otherTexts": "{{steps.otherTexts.texts}}",
    "buttonTexts": "{{steps.buttonTexts.texts}}",
    "screenshot": "{{steps.screenshot}}",
    "uiSource": "{{steps.uiSource}}",
    "compactSnapshot": "{{steps.compactSnapshot}}"
  }
}
