{
  "id": "rzn-phone",
  "version": "0.0.3",
  "name": "RZN Phone",
  "description": "Public phone automation capability for RZN, implemented by the rzn-phone worker runtime",
  "min_host_version": "0.1.0",
  "mcp_protocol_version": "2025-06-18",
  "requires_entitlement": false,
  "required_product_ids": [],
  "platforms": [
    "macos_universal"
  ],
  "workers": [
    {
      "id": "ios",
      "kind": "mcp_stdio",
      "auto_start": false,
      "tools_namespace": "plugin:rzn-phone",
      "entrypoints": {
        "macos_universal": "bin/macos/universal/rzn-phone-worker"
      },
      "args": [],
      "env": {}
    }
  ],
  "payloads": [
    {
      "source": "$RZN_PHONE_ROOT/dist/bin/macos/universal/rzn-phone-worker",
      "dest": "bin/macos/universal/rzn-phone-worker",
      "platforms": [
        "macos_universal"
      ],
      "mode": "755"
    },
    {
      "source": "$RZN_PHONE_ROOT/crates/rzn_phone_worker/resources/workflows",
      "dest": "resources/workflows",
      "platforms": [
        "macos_universal"
      ],
      "mode": "644"
    },
    {
      "source": "$RZN_PHONE_ROOT/crates/rzn_phone_worker/resources/systems",
      "dest": "resources/systems",
      "platforms": [
        "macos_universal"
      ],
      "mode": "644"
    },
    {
      "source": "$RZN_PHONE_ROOT/examples/phone_messages",
      "dest": "examples/phone_messages",
      "platforms": [
        "macos_universal"
      ],
      "mode": "644"
    },
    {
      "source": "$RZN_PHONE_ROOT/examples/phone_calls",
      "dest": "examples/phone_calls",
      "platforms": [
        "macos_universal"
      ],
      "mode": "644"
    },
    {
      "source": "$RZN_PHONE_ROOT/examples/phone_notifications",
      "dest": "examples/phone_notifications",
      "platforms": [
        "macos_universal"
      ],
      "mode": "644"
    },
    {
      "source": "$RZN_PHONE_ROOT/skills",
      "dest": "skills",
      "platforms": [
        "macos_universal"
      ],
      "mode": "644"
    }
  ],
  "shared_payloads": [
    {
      "source": "$RZN_PHONE_ROOT/LICENSE",
      "dest": "LICENSE",
      "mode": "644"
    }
  ]
}
